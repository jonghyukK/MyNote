<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/cl"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Search Layouts.. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_tool_container"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 백 버튼 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground"
            app:srcCompat="@drawable/ic_chevron_left_24_white"
            app:tint="@color/black_800"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Search Input Box -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_rounded_edit_text"
            android:textSize="14sp"
            android:textColor="@color/black_900"
            android:textColorHint="@color/black_600"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:hint="@string/hint_input_place_or_region"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="35dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_clear"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:padding="2dp"
            android:background="@drawable/shape_s_black_400_c_999"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_close_24_white"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="@+id/et_search"
            app:layout_constraintBottom_toBottomOf="@+id/et_search"
            app:layout_constraintEnd_toEndOf="@+id/et_search" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingVertical="15dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/cl_search_tool_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Init View -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_init_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/cl_search_tool_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_search_info1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_search_info_1"
            android:textSize="18sp"
            android:textColor="@color/black_700"
            app:layout_constraintVertical_bias="0.3"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_search_info2" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_search_info2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_search_info_2"
            android:textSize="14sp"
            android:textColor="@color/black_500"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_search_info1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_search_info3"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_search_info3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_search_info_3"
            android:textSize="14sp"
            android:textColor="@color/black_500"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_search_info2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Empty Results View -->
    <include
        layout="@layout/layout_empty_search_results"
        android:id="@+id/layout_empty_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cl_search_tool_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        layout="@layout/layout_loading"
        android:id="@+id/layout_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cl_search_tool_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>