<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:background="?attr/selectableItemBackground"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_search"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:srcCompat="@drawable/ic_search_24"
        app:tint="@color/black_400"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_result_place_name" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_result_place_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textColor="@color/black_800"
        android:layout_marginStart="6dp"
        android:paddingVertical="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_search"
        app:layout_constraintBottom_toTopOf="@+id/tv_result_address"
        tools:text="hello?" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_result_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/black_500"
        app:layout_constraintTop_toBottomOf="@+id/tv_result_place_name"
        app:layout_constraintStart_toStartOf="@+id/tv_result_place_name"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="hello?"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_place_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_marginEnd="5dp"
        android:paddingHorizontal="6dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/shape_s_purple_200_c_10"
        app:layout_constraintTop_toTopOf="@+id/tv_result_place_name"
        app:layout_constraintStart_toEndOf="@+id/tv_result_place_name"
        app:layout_constraintBottom_toBottomOf="@+id/tv_result_place_name"
        tools:text="+1"/>


</androidx.constraintlayout.widget.ConstraintLayout>