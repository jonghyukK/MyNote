<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="24dp"
    android:paddingBottom="28dp"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_date"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_prev_month"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackground"
            app:srcCompat="@drawable/ic_arrow_left"
            app:tint="@color/black_800"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/black_800"
            android:fontFamily="@font/spoqa_han_sans_neo_bold"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="3dp"
            tools:text="2024년 12월"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_prev_month" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_next_month"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackground"
            app:srcCompat="@drawable/ic_arrow_right"
            app:tint="@color/black_800"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_date" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title_total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="총 갯수"
        android:textSize="16sp"
        android:textColor="@color/black_600"
        android:paddingEnd="14dp"
        android:paddingStart="20dp"
        android:fontFamily="@font/spoqa_han_sans_neo_regular"
        app:layout_constraintTop_toBottomOf="@+id/cl_date"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textColor="@color/black_900"
        android:fontFamily="@font/spoqa_han_sans_neo_bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_title_total_count"
        app:layout_constraintStart_toEndOf="@+id/tv_title_total_count"
        tools:text="39건" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title_total_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="총 금액"
        android:textSize="16sp"
        android:textColor="@color/black_600"
        android:layout_marginTop="10dp"
        android:paddingEnd="14dp"
        android:paddingStart="20dp"
        android:fontFamily="@font/spoqa_han_sans_neo_regular"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_count"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_total_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textColor="@color/black_900"
        android:fontFamily="@font/spoqa_han_sans_neo_bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_title_total_price"
        app:layout_constraintTop_toTopOf="@+id/tv_title_total_price"
        app:layout_constraintStart_toEndOf="@+id/tv_title_total_price"
        tools:text="2,392,103원" />


</androidx.constraintlayout.widget.ConstraintLayout>