<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="0dp"
    android:paddingBottom="20dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="구매노트 1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black_900"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/ic_delete_24"
        app:tint="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 카테고리 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
        android:id="@+id/tv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:isRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:title="@string/category" />

    <!-- 구매명 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithEditTextView
        android:id="@+id/et_purchase_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:hint="@string/hint_input_purchase_name"
        android:imeOptions="actionNext"
        app:isRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_category"
        app:title="@string/purchase_name" />

    <!-- 가장 최근에 등록한 구매명 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent_purchase_names"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone"
        android:imeOptions="actionDone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gl_guideline"
        app:layout_constraintTop_toBottomOf="@+id/et_purchase_name" />

    <!-- 구매 금액 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithEditTextView
        android:id="@+id/et_purchase_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:hint="@string/hint_input_purchase_price"
        android:imeOptions="actionDone"
        android:inputType="number"
        app:isRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_recent_purchase_names"
        app:title="@string/purchase_price" />

    <!-- 구매 날짜 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
        android:id="@+id/tv_purchase_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:isRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_purchase_price"
        app:title="@string/purchase_date" />

    <!-- 결제 수단 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
        android:id="@+id/tv_payment_method"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:isRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_purchase_date"
        app:title="@string/payment_method" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_register_default_payment_method"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/gl_guideline"
        app:layout_constraintTop_toBottomOf="@+id/tv_payment_method">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_unselected_checkbox"
            app:tint="@color/colorPrimary" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="기본 결제수단으로 등록할래요!"
            android:textColor="@color/black_600"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_checkbox"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 구매 장소 -->
    <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
        android:id="@+id/tv_purchase_place"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:isRequired="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_register_default_payment_method"
        app:title="@string/purchase_place" />

    <!-- 사진 첨부 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title_attach_images"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/attach_image"
        android:textColor="@color/black_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_purchase_place" />

    <!-- 사진 첨부 Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_attach_images"
        android:layout_width="55dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/ripple_shape_c_8_l_black_500"
        android:paddingVertical="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_attach_images">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_camera"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_camera_24_purple"
            app:tint="@color/black_500" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_image_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/black_500"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_camera"
            tools:text="1/3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 임시 이미지들 Layout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_temp_images"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/cl_attach_images"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cl_attach_images"
        app:layout_constraintTop_toTopOf="@+id/cl_attach_images" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_add"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/do_add"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:background="@drawable/ripple_shape_s_white_c_8_l_color_primary"
        android:layout_marginEnd="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_attach_images"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>