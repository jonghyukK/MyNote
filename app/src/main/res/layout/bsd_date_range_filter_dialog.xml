<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Title -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/date_period"
        android:textSize="18sp"
        android:textColor="@color/black_800"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Reset Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_reset_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="@+id/iv_close"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintBottom_toBottomOf="@+id/iv_close" >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_reset"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_reset_24"
            app:tint="@color/black_400"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_reset"
            app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:textSize="14sp"
            android:textColor="@color/black_800"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackground"
        app:srcCompat="@drawable/ic_close_24_white"
        app:tint="@color/black_800"
        app:layout_constraintTop_toTopOf="@+id/tv_title_filter"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_filter"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_month_filter_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 월별 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_monthly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/monthly"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:background="@drawable/shape_s_white_c_4_l_black_200"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_one_month"/>

        <!-- 월별 필터 선택 Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_select_monthly_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tv_monthly"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_selectable_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/black_800"
                android:textStyle="bold"
                tools:text="2024년 11월"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_arrow_down_24"
                app:tint="@color/purple"
                app:layout_constraintTop_toTopOf="@+id/tv_selectable_month"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/tv_selectable_month" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 직접입력 필터 선택 Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_select_directly_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_monthly"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_start_date"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="14sp"
                android:textColor="@color/black_800"
                android:gravity="center"
                android:layout_marginEnd="15dp"
                android:background="@drawable/shape_s_white_c_4_l_black_200"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/gl_guideline"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="2024-11-03" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ~ "
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/gl_guideline"
                app:layout_constraintEnd_toStartOf="@+id/gl_guideline" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_end_date"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="14sp"
                android:textColor="@color/black_800"
                android:gravity="center"
                android:layout_marginStart="15dp"
                android:background="@drawable/shape_s_white_c_4_l_black_200"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/gl_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="2024-11-03" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 1개월 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_one_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/one_month"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:background="@drawable/shape_s_white_c_4_l_black_200"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toTopOf="@+id/tv_monthly"
            app:layout_constraintStart_toEndOf="@+id/tv_monthly"
            app:layout_constraintEnd_toStartOf="@+id/tv_three_month" />

        <!-- 3개월 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_three_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/three_month"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:background="@drawable/shape_s_white_c_4_l_black_200"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toTopOf="@+id/tv_monthly"
            app:layout_constraintStart_toEndOf="@+id/tv_one_month"
            app:layout_constraintEnd_toStartOf="@+id/tv_directly" />

        <!-- 직접입력 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_directly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/input_directly"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:background="@drawable/shape_s_white_c_4_l_black_200"
            app:layout_constraintTop_toTopOf="@+id/tv_monthly"
            app:layout_constraintStart_toEndOf="@+id/tv_three_month"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 적용하기 -->
    <com.kjh.mynote.ui.common.components.MyBottomButton
        android:id="@+id/btn_apply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_marginTop="24dp"
        app:btnTitle="@string/do_apply"
        app:layout_constraintTop_toBottomOf="@+id/cl_month_filter_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>