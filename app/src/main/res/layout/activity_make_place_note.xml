<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ToolBar -->
    <com.kjh.mynote.ui.common.components.MyToolBar
        android:id="@+id/tb_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:isShowBackButton="true"
        app:leftTitle="@string/make_place_note"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/tb_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_save">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 사진 첨부 Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_attach_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:text="@string/attach_image"
                android:textColor="@color/black_800"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"
                android:textColor="@color/red_500"
                app:layout_constraintTop_toTopOf="@+id/tv_title_attach_images"
                app:layout_constraintStart_toEndOf="@+id/tv_title_attach_images"/>

            <!-- 사진 첨부 Layout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_attach_images"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                android:paddingVertical="7dp"
                android:background="@drawable/ripple_shape_c_8_l_black_500"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_attach_images"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_camera"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_camera_24_purple"
                    app:tint="@color/black_500"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_image_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/black_500"
                    app:layout_constraintTop_toBottomOf="@+id/iv_camera"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="1/3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 임시 이미지들 Layout -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_temp_images"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toTopOf="@+id/cl_attach_images"
                app:layout_constraintStart_toEndOf="@+id/cl_attach_images"
                app:layout_constraintBottom_toBottomOf="@+id/cl_attach_images"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 방문 장소 -->
            <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
                android:id="@+id/tv_visit_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:title="@string/visit_place"
                app:isRequired="true"
                android:gravity="end"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_attach_images"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 방문 날짜 Layout -->
            <com.kjh.mynote.ui.common.components.MyTitleWithSelectableTextView
                android:id="@+id/tv_visit_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:title="@string/visit_date"
                app:isRequired="true"
                android:gravity="end"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_visit_place"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 내용 Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_contents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="@string/write_contents"
                android:textColor="@color/black_800"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_visit_date"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 내용 -->
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_note_contents"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:textSize="15sp"
                android:textColor="@color/black_900"
                android:hint="@string/input_contents"
                android:background="@drawable/selector_rounded_edit_text"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_contents"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_make_with_purchase_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/make_with_purchase_note"
                android:textColor="@color/black_800"
                android:textSize="16sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/et_note_contents"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_purchase_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_make_with_purchase_note"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_add_purchase_note"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="20dp"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@+id/rv_purchase_notes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_add_24"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="@+id/tv_add_purchase_note"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_add_purchase_note"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_add_purchase_note" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_add_purchase_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_purchase_note"
                    android:textSize="16sp"
                    android:textColor="@color/black_600"
                    android:layout_marginStart="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_add"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.kjh.mynote.ui.common.components.MyBottomButton
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:btnTitle="@string/do_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>