<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:srcCompat="@drawable/ic_close_24_white"
        app:tint="@color/black_900"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter"
        android:textSize="20sp"
        android:textColor="@color/black_900"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/iv_close"
        app:layout_constraintBottom_toTopOf="@+id/sv_container"/>

    <ScrollView
        android:id="@+id/sv_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_reset">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Category -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category"
                android:textSize="18sp"
                android:textColor="@color/black_800"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_category"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/divider1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/black_100"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/rv_categories"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구매명 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_purchase_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/purchase_name"
                android:textSize="18sp"
                android:textColor="@color/black_800"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/divider1"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_purchase_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_rounded_edit_text"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:hint="@string/hint_input_purchase_name_to_search"
                android:textColorHint="@color/black_500"
                android:textSize="15sp"
                android:textColor="@color/black_800"
                android:inputType="text"
                android:imeOptions="actionDone"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_purchase_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="편의점" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_clear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_s_black_400_c_999"
                android:padding="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/et_purchase_name"
                app:layout_constraintEnd_toEndOf="@+id/et_purchase_name"
                app:layout_constraintTop_toTopOf="@+id/et_purchase_name"
                app:srcCompat="@drawable/ic_close_24_white"
                app:tint="@color/white" />

            <View
                android:id="@+id/divider2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/black_100"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/et_purchase_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 가격 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price"
                android:textSize="18sp"
                android:textColor="@color/black_800"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_min_price"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/selector_rounded_edit_text"
                android:textColor="@color/black_800"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:inputType="number"
                android:imeOptions="actionNext"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_price"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/gl_guideline"
                tools:text="1000000" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ~ "
                app:layout_constraintBottom_toBottomOf="@+id/et_min_price"
                app:layout_constraintEnd_toStartOf="@+id/gl_guideline"
                app:layout_constraintStart_toEndOf="@+id/gl_guideline"
                app:layout_constraintTop_toTopOf="@+id/et_min_price" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_max_price"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/selector_rounded_edit_text"
                android:textColor="@color/black_800"
                android:textSize="14sp"
                android:layout_marginEnd="20dp"
                android:paddingHorizontal="12dp"
                android:inputType="number"
                android:imeOptions="actionDone"
                app:layout_constraintBottom_toBottomOf="@+id/et_min_price"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/gl_guideline"
                app:layout_constraintTop_toTopOf="@+id/et_min_price"
                tools:text="200000" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv1"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@color/purple_100"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/et_max_price"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv2"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@color/purple_200"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/iv1"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

<!--    <androidx.constraintlayout.widget.Guideline-->
<!--        android:id="@+id/gl_bottom"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal"-->
<!--        app:layout_constraintGuide_end="60dp" />-->

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/reset"
        android:background="?attr/colorOnPrimaryContainer"
        app:layout_constraintHorizontal_weight="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_apply" />

    <Button
        android:id="@+id/btn_apply"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/do_apply"
        app:layout_constraintHorizontal_weight="0.7"
        app:layout_constraintStart_toEndOf="@+id/btn_reset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>