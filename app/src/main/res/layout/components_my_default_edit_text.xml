<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/selector_rounded_edit_text"
        android:paddingHorizontal="12dp"
        android:textColorHint="@color/black_500"
        android:textSize="15sp"
        android:textColor="@color/black_800"
        android:inputType="text"
        android:imeOptions="actionDone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_clear"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_s_black_400_c_999"
        android:padding="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/et_text"
        app:layout_constraintEnd_toEndOf="@+id/et_text"
        app:layout_constraintTop_toTopOf="@+id/et_text"
        app:srcCompat="@drawable/ic_close_24_white"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>