<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@id/tb_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CustomAttribute
                app:attributeName="backgroundColor"
                app:customColorValue="@color/transparent" />
            <CustomAttribute
                app:attributeName="backButtonTint"
                app:customColorValue="@color/white" />
            <CustomAttribute
                app:attributeName="moreButtonTint"
                app:customColorValue="@color/white" />
            <PropertySet app:visibilityMode="ignore" />
        </Constraint>

        <Constraint
            android:id="@+id/tv_deleted_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tb_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <PropertySet app:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@id/tb_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CustomAttribute
                app:attributeName="backgroundColor"
                app:customColorValue="@color/white" />
            <CustomAttribute
                app:attributeName="backButtonTint"
                app:customColorValue="@color/black_900" />
            <CustomAttribute
                app:attributeName="moreButtonTint"
                app:customColorValue="@color/black_900" />
            <PropertySet app:visibilityMode="ignore" />
        </Constraint>
        <Constraint
            android:id="@+id/tv_deleted_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tb_toolbar">
            <PropertySet app:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>

    <Transition
        app:constraintSetEnd="@id/end"
        app:constraintSetStart="@id/start"
        app:duration="300" />
</MotionScene>