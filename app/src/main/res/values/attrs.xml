<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="isRequired" format="boolean" />
    <attr name="title" format="reference|string" />

    <declare-styleable name="MyToolBar">
        <attr name="isShowBackButton" format="boolean" />
        <attr name="leftTitle" format="reference|string" />
        <attr name="backButtonTint" format="reference|color" />
        <attr name="backButtonBg" format="reference|integer" />
        <attr name="isShowMoreButton" format="boolean" />
        <attr name="moreButtonTint" format="reference|color" />
        <attr name="moreButtonBg" format="reference" />
        <attr name="rightFirstImage" format="reference|integer" />
        <attr name="rightSecondImage" format="reference|integer" />
    </declare-styleable>

    <declare-styleable name="MyBSDialogToolBar">
        <attr name="title" />
        <attr name="showResetBtn" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MyBottomButton">
        <attr name="btnTitle" format="reference|string" />
        <attr name="isEnable" format="boolean" />
        <attr name="isLoading" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MyTitleWithEditTextView">
        <attr name="title" />
        <attr name="isRequired" />
        <attr name="android:inputType" />
        <attr name="android:imeOptions" />
        <attr name="android:hint" />
    </declare-styleable>

    <declare-styleable name="MyDefaultEditText">
        <attr name="android:inputType" />
        <attr name="android:imeOptions" />
        <attr name="android:hint" />
    </declare-styleable>

    <declare-styleable name="MyTitleWithSelectableTextView">
        <attr name="title" />
        <attr name="isRequired" />
        <attr name="titleTextColor" format="reference|color" />
        <attr name="android:text" />
        <attr name="android:gravity" />
        <attr name="android:textStyle" />
    </declare-styleable>

    <declare-styleable name="MyTitleWithTextView">
        <attr name="title" />
        <attr name="android:text" />
        <attr name="android:gravity" />
        <attr name="android:textStyle" />
    </declare-styleable>

    <declare-styleable name="MyWeekCalendarView">
        <attr name="isOnlyThisWeek" format="boolean" />
    </declare-styleable>
</resources>